{
  "$schema": "https://raw.githubusercontent.com/brianwestphal/kerf/main/ui/ai/component-catalog-extension.schema.json",
  "schemaVersion": 1,
  "package": "glassbox2",
  "description": "Glassbox components for reviewing changes and sharing feedback.",
  "entries": [
    {
      "id": "appearance-menu",
      "name": "Appearance Menu",
      "kind": "component",
      "purpose": "Choose System, Light, or Dark appearance.",
      "useWhen": [
        "Choose the appearance of the shared workbench."
      ],
      "avoidWhen": [
        "Choose a setting unrelated to appearance."
      ],
      "publicClasses": [
        "appearance-menu"
      ],
      "publicTokens": [],
      "uses": [
        "toolbar-control-group",
        "lucide-icon",
        "popup-menu"
      ],
      "source": "src/components/settings/appearance-menu.tsx",
      "demoSource": "src/ux-demo/demos/settings/appearance-menu.tsx",
      "geometry": {
        "margin": "none",
        "border": "none",
        "padding": "none"
      },
      "documentation": "docs/ui-conventions.md"
    },
    {
      "id": "review-navigator",
      "name": "Review Navigator",
      "kind": "composition",
      "purpose": "Open a review source and navigate its changed files.",
      "useWhen": [
        "Open or navigate a comparison."
      ],
      "avoidWhen": [
        "Display a standalone file view."
      ],
      "publicClasses": [
        "review-navigator"
      ],
      "publicTokens": [],
      "uses": [
        "badge",
        "button",
        "empty-state",
        "select",
        "text-field",
        "tree-list",
        "source-context"
      ],
      "source": "src/components/review/review-navigator.tsx",
      "styleSources": [
        "src/components/review/review-navigator.css"
      ],
      "demoSource": "src/ux-demo/demos/review/review-navigator.tsx",
      "geometry": {
        "margin": "none",
        "border": "none",
        "padding": "none"
      },
      "documentation": "docs/ui-conventions.md"
    },
    {
      "id": "review-workbench",
      "name": "Review Workbench",
      "kind": "composition",
      "purpose": "Arrange source files, a comparison, and a contextual inspector in a responsive review shell.",
      "useWhen": [
        "Display the Glassbox review shell."
      ],
      "avoidWhen": [
        "Display one standalone component without app chrome."
      ],
      "publicClasses": [
        "review-workbench"
      ],
      "publicTokens": [],
      "uses": [
        "workbench",
        "toolbar-text",
        "review-navigator",
        "text-diff",
        "appearance-menu"
      ],
      "source": "src/components/review/review-workbench.tsx",
      "styleSources": [
        "src/components/review/review-workbench.css"
      ],
      "demoSource": "src/ux-demo/demos/review/review-workbench.tsx",
      "geometry": {
        "margin": "none",
        "border": "none",
        "padding": "none"
      },
      "documentation": "docs/ui-conventions.md"
    },
    {
      "id": "source-context",
      "name": "Review Source Context",
      "kind": "component",
      "purpose": "Show the branch or path pair and comparison type for the active review.",
      "useWhen": [
        "Show the identity and comparison type of the active review."
      ],
      "avoidWhen": [
        "Offer a source selection action."
      ],
      "publicClasses": [
        "source-context"
      ],
      "publicTokens": [],
      "source": "src/components/review/source-context.tsx",
      "styleSources": [
        "src/components/review/source-context.css"
      ],
      "demoSource": "src/ux-demo/demos/review/source-context.tsx",
      "geometry": {
        "margin": "none",
        "border": "none",
        "padding": "none"
      },
      "documentation": "docs/ui-conventions.md"
    },
    {
      "id": "text-diff",
      "name": "Text Diff",
      "kind": "composition",
      "purpose": "Review changed text in two independently wrappable layouts.",
      "useWhen": [
        "Review text changes with original and updated line mappings."
      ],
      "avoidWhen": [
        "Compare image or binary content."
      ],
      "publicClasses": [
        "text-diff"
      ],
      "publicTokens": [],
      "uses": [
        "toolbar-control-group",
        "lucide-icon"
      ],
      "source": "src/components/diff/text-diff.tsx",
      "styleSources": [
        "src/components/diff/text-diff.css"
      ],
      "demoSource": "src/ux-demo/demos/diff/text-diff.tsx",
      "geometry": {
        "margin": "none",
        "border": "none",
        "padding": "none"
      },
      "documentation": "docs/ui-conventions.md"
    }
  ]
}
